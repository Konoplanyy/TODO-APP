{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AutoMapper": {
    "LicenseKey": "auto-mapper-license-key"
  },
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=Data/app.db"
  },
  "Jwt": {
    "Secret": "jwt-secret",
    "Issuer": "TodoApi",
    "Audience": "TodoApiClient",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  }
}
